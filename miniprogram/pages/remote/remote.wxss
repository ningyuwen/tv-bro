.page { padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.masthead { display: flex; flex-direction: column; padding: 10rpx 0 32rpx; }
.eyebrow { color: #688077; font-size: 21rpx; letter-spacing: 4rpx; }
.title { font-size: 44rpx; font-weight: 650; margin-top: 18rpx; }
.connection { display: flex; align-items: center; font-size: 24rpx; color: #5d7269; margin-bottom: 28rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #afbbb3; margin-right: 14rpx; flex-shrink: 0; }
.dot.online { background: #52962c; }
.card { background: white; border: 1rpx solid #e2e8df; border-radius: 28rpx; padding: 28rpx; margin-top: 24rpx; }
.section-title { display: block; font-size: 30rpx; font-weight: 650; margin-bottom: 22rpx; }
.hint { display: block; font-size: 28rpx; line-height: 1.8; color: #5d7269; margin-bottom: 30rpx; }
.device { margin-bottom: 24rpx; }
.device .device-button { display: flex; flex-direction: column; align-items: center; width: 100%; min-width: 0; box-sizing: border-box; margin: 0; padding: 24rpx; line-height: 1.5; }
.device-name { max-width: 100%; font-weight: 650; overflow-wrap: break-word; }
.device-host { max-width: 100%; margin-top: 8rpx; font-size: 25rpx; color: #5d7269; overflow-wrap: break-word; }
.footnote { display: block; font-size: 23rpx; line-height: 1.7; color: #829088; margin-top: 20rpx; }
.row { display: flex; gap: 14rpx; }
.websites-card { padding: 24rpx 20rpx; }
.websites-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 8rpx 20rpx; }
.websites-heading .section-title { margin-bottom: 0; }
.websites-caption { color: #829088; font-size: 22rpx; }
.websites-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18rpx 8rpx; }
/* Override the style v2 button width inside each grid cell. */
.websites-grid .website { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-width: 0; box-sizing: border-box; margin: 0; min-height: 120rpx; padding: 8rpx 0; line-height: 1.4; background: transparent; border-radius: 16rpx; }
.website-badge { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 18rpx; color: white; font-size: 30rpx; font-weight: 650; }
.website-name { display: block; max-width: 100%; margin-top: 12rpx; font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.website-pressed { background: #e9efe5; }
.trackpad { height: 42vh; min-height: 460rpx; max-height: 720rpx; background: #132d29; border-radius: 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #cce3c0; }
.pad-symbol { font-size: 90rpx; line-height: 1; color: #bbf56f; font-weight: 200; }
.pad-title { margin-top: 25rpx; font-size: 29rpx; letter-spacing: 6rpx; }
.pad-hint { margin-top: 20rpx; font-size: 23rpx; color: #8daa9e; }
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 20rpx; }
.footer { display: block; text-align: center; color: #98a59b; font-size: 21rpx; margin-top: 36rpx; }
.media-time { display: flex; justify-content: space-between; color: #5d7269; font-size: 25rpx; font-variant-numeric: tabular-nums; }
.media-card slider { margin: 20rpx 12rpx 28rpx; }
.media-buttons button { font-size: 25rpx; padding: 0 8rpx; }
.volume-heading, .volume-mute { display: flex; align-items: center; justify-content: space-between; }
.volume-heading .section-title { margin-bottom: 0; }
.volume-value { color: #5d7269; font-size: 28rpx; font-variant-numeric: tabular-nums; }
.volume-card slider { margin: 24rpx 12rpx; }
.volume-mute { font-size: 27rpx; }

.navigation-pad { background: #203b29; }
.pad-focus { max-width: 85%; margin-top: 28rpx; padding: 12rpx 22rpx; border: 1rpx solid #718d63; border-radius: 14rpx; font-size: 27rpx; text-align: center; overflow-wrap: break-word; }
.remote-tools { margin-top: 18rpx; }
.remote-tools button { flex: 1; min-width: 0; }
.direction-pad { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(3, 80rpx); gap: 12rpx; max-width: 460rpx; margin: 0 auto; }
.direction-pad button { width: 100%; min-width: 0; margin: 0; padding: 0; line-height: 80rpx; }
.direction-up { grid-column: 2; grid-row: 1; }
.direction-left { grid-column: 1; grid-row: 2; }
.direction-ok { grid-column: 2; grid-row: 2; }
.direction-right { grid-column: 3; grid-row: 2; }
.direction-down { grid-column: 2; grid-row: 3; }
.quality-panel { border-top: 1rpx solid #e2e8df; margin-top: 24rpx; padding-top: 24rpx; }
.quality-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.quality-status { display: flex; flex-direction: column; min-width: 0; font-size: 26rpx; }
.quality-target { color: #5d7269; font-size: 23rpx; margin-top: 8rpx; }
.quality-heading .quality-toggle { flex-shrink: 0; width: auto; margin: 0; padding: 0 20rpx; font-size: 24rpx; }
.quality-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 20rpx; }
.quality-options .quality-option { width: 100%; min-width: 0; margin: 0; padding: 12rpx 8rpx; font-size: 24rpx; line-height: 1.6; }
.quality-options .quality-selected { background: #e9f3df; color: #396b20; }
