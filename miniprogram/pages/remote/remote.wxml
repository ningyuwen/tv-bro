<view class="page">
  <view class="masthead"><text class="eyebrow">LIME / TV REMOTE</text><text class="title">大屏浏览，小屏掌控。</text></view>
  <view class="connection"><view class="dot {{connected ? 'online' : ''}}"></view><text>{{status}}</text></view>
  <view wx:if="{{!connected}}" class="pair card">
    <text class="section-title">连接你的电视</text>
    <text class="hint">电视打开青柠浏览器，小程序会自动寻找盒子。首次连接只需在电视上选择「允许并记住」。</text>
    <view wx:for="{{devices}}" wx:key="deviceId" class="device">
      <button class="device-button" data-index="{{index}}" bindtap="choose">
        <text class="device-name">{{item.name}}</text>
        <text class="device-host">{{item.host}}</text>
      </button>
    </view>
    <button class="primary" bindtap="find" loading="{{busy && connectionAction === 'find'}}">{{busy && connectionAction === 'find' ? '正在寻找…' : '重新寻找电视'}}</button>
    <button class="quiet" bindtap="scan">扫码配对（备用）</button>
    <button class="quiet" bindtap="toggleManual">{{manual ? '收起' : '手动输入地址'}}</button>
    <view wx:if="{{manual}}" class="manual">
      <input placeholder="盒子地址，例如 192.168.2.130" value="{{host}}" data-field="host" bindinput="field" />
      <view class="row"><input type="number" placeholder="端口" value="{{port}}" data-field="port" bindinput="field" /><input type="number" maxlength="6" placeholder="配对码（可不填）" value="{{code}}" data-field="code" bindinput="field" /></view>
      <button class="primary" loading="{{busy && connectionAction === 'connect'}}" bindtap="connect">连接</button>
    </view>
    <text class="footnote">手机与盒子连接同一 Wi-Fi，无需电脑常驻。</text>
  </view>
  <block wx:else>
    <view class="trackpad {{navigation ? 'navigation-pad' : ''}}" catchtouchstart="touchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchCancel">
      <text class="pad-symbol">{{navigation ? '↔' : '＋'}}</text>
      <text class="pad-title">{{navigation ? '界面导航' : '触控板'}}</text>
      <text class="pad-hint">{{navigation ? '滑动切换选项 · 轻点确定' : '单指移动 · 轻点点击 · 双指上下/左右滚动'}}</text>
      <text wx:if="{{navigation && focusedControl}}" class="pad-focus">当前选中：{{focusedControl}}</text>
    </view>
    <view class="remote-tools row">
      <button bindtap="toggleDirections">{{showDirections ? '收起方向键' : '方向键'}}</button>
      <button data-op="back" bindtap="command">返回 / 关闭</button>
    </view>
    <view wx:if="{{showDirections}}" class="card direction-card">
      <view class="direction-pad">
        <button class="direction-up" data-op="up" bindtap="command" aria-label="向上">↑</button>
        <button class="direction-left" data-op="left" bindtap="command" aria-label="向左">←</button>
        <button class="direction-ok primary" data-op="ok" bindtap="command">确定</button>
        <button class="direction-right" data-op="right" bindtap="command" aria-label="向右">→</button>
        <button class="direction-down" data-op="down" bindtap="command" aria-label="向下">↓</button>
      </view>
      <text class="footnote">{{navigationSupported ? '上下切换区域，左右选择按钮；返回关闭当前界面。' : '请更新电视浏览器，以使用触控板菜单导航。'}}</text>
    </view>
    <view class="quick grid">
      <button data-op="back" bindtap="command">← 返回</button><button data-op="home" bindtap="command">⌂ 首页</button><button data-op="refresh" bindtap="command">↻ 刷新</button>
      <button data-op="menu" bindtap="command">☰ 菜单</button><button data-op="nextTab" bindtap="command">▣ 标签</button><button data-op="playPause" bindtap="command">播放 / 暂停</button>
      <button data-op="newTab" bindtap="command">新标签</button><button data-op="closeTab" bindtap="command">关闭标签</button>
      <button bindtap="toggleFullscreen" disabled="{{fullscreenBusy}}">全屏 / 退出</button>
    </view>
    <view class="card media-card">
      <text class="section-title">视频进度</text>
      <view class="media-time"><text>{{media.currentLabel}}</text><text>{{media.durationLabel}}</text></view>
      <slider min="0" max="1000" step="1" value="{{media.slider}}" disabled="{{!media.canSeek}}"
        activeColor="#52962c" backgroundColor="#e2e8df" block-size="24"
        bindtouchstart="seekStart" bindtouchend="seekEnd" bindchanging="seekChanging" bindchange="seekChange" bindtouchcancel="seekCancel" />
      <view class="row media-buttons">
        <!-- Handlers guard pending requests and quality switches; only capability affects appearance. -->
        <button data-seconds="-10" bindtap="skipMedia" disabled="{{!media.canSeek}}">后退 10 秒</button>
        <button bindtap="toggleMedia" disabled="{{!media.available}}">{{media.paused ? '播放' : '暂停'}}</button>
        <button data-seconds="10" bindtap="skipMedia" disabled="{{!media.canSeek}}">快进 10 秒</button>
      </view>
      <text class="footnote">{{media.hint}}</text>
      <view wx:if="{{media.available}}" class="quality-panel">
        <view class="quality-heading">
          <view class="quality-status"><text>清晰度 · {{media.quality.currentLabel}}</text>
            <text wx:if="{{media.quality.supported}}" class="quality-target">已选：{{media.quality.selectedLabel}}</text>
          </view>
          <button wx:if="{{media.quality.supported}}" class="quality-toggle" bindtap="chooseQuality">{{qualityChoices.length ? '收起' : '选择清晰度'}}</button>
        </view>
        <view wx:if="{{qualityChoices.length}}" class="quality-options">
          <button wx:for="{{qualityChoices}}" wx:key="id" data-id="{{item.id}}" data-media-id="{{item.mediaId}}"
            class="quality-option {{item.id === media.quality.selectedId ? 'quality-selected' : ''}}"
            bindtap="setQuality">{{item.label}}</button>
        </view>
        <text class="footnote">{{media.quality.hint}}</text>
      </view>
    </view>
    <view class="card volume-card">
      <view class="volume-heading"><text class="section-title">机顶盒音量</text><text class="volume-value">{{volume.ready ? volume.percent + '%' : '—'}}</text></view>
      <slider min="0" max="100" step="1" value="{{volume.percent}}" disabled="{{!volume.supported}}"
        activeColor="#52962c" backgroundColor="#e2e8df" block-size="24"
        bindtouchstart="volumeStart" bindtouchend="volumeEnd" bindchanging="volumeChanging" bindchange="volumeChange" bindtouchcancel="volumeCancel" />
      <view class="volume-mute"><text>静音</text><switch color="#52962c" checked="{{volume.muted}}" disabled="{{!volume.supported}}" bindchange="muteChange" /></view>
      <text class="footnote">{{volume.hint}}</text>
    </view>
    <view class="card input-card"><text class="section-title">手机输入</text>
      <textarea placeholder="输入网址、搜索词或网页文字" value="{{text}}" maxlength="4096" data-field="text" bindinput="field" />
      <view class="row"><button class="primary" data-op="open" bindtap="send">打开 / 搜索</button><button data-op="text" bindtap="send">输入到网页</button></view>
      <text class="footnote">输入到网页前，先点中电视网页的输入框。</text>
    </view>
    <view class="card websites-card">
      <view class="websites-heading"><text class="section-title">常用网站</text><text class="websites-caption">点一下，在电视打开</text></view>
      <view class="websites-grid">
        <button wx:for="{{websites}}" wx:key="id" class="website" data-id="{{item.id}}" bindtap="openWebsite" hover-class="website-pressed">
          <text class="website-badge" style="background: {{item.color}};">{{item.badge}}</text>
          <text class="website-name">{{openingWebsite === item.id ? '正在打开…' : item.name}}</text>
        </button>
      </view>
    </view>
    <button class="quiet" bindtap="disconnect">断开连接</button>
  </block>
  <text class="footer">青柠浏览器 · 家中局域网连接</text>
</view>
